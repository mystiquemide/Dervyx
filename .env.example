# Optional local configuration

# Optional custom Base RPC endpoint. Defaults to the public Base mainnet RPC.
BASE_RPC_URL=https://mainnet.base.org

# Canonical URL used for Open Graph and Twitter metadata.
NEXT_PUBLIC_SITE_URL=https://dervyx.vercel.app

# Optional browser-facing API origin for a split Vercel frontend + VPS backend.
# Leave blank for the same-process local/standalone Next.js API.
DERVYX_API_ORIGIN=

# Optional OpenAI-compatible branch selector. Leave blank for deterministic fallback.
DERVYX_MODEL_BASE_URL=
DERVYX_MODEL_API_KEY=
DERVYX_MODEL_NAME=
DERVYX_MODEL_TIMEOUT_MS=8000
