{
  "name": "dervyx",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first Base investigation agent",
  "type": "module",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "build:engine": "tsc -p tsconfig.engine.json",
    "typecheck": "tsc --noEmit -p tsconfig.engine.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:engine && node --test dist/test/*.test.js",
    "verify:report": "npm run build:engine && node scripts/verify-report.mjs",
    "fixtures:generate": "npm run build:engine && node scripts/generate-fixtures.mjs",
    "verify:fixtures": "npm run build:engine && node scripts/verify-fixtures.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.55.18",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  }
}
